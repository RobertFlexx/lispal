(program BackendCoverage
  (begin
    (assert (= (/ 9 2) 4.5))
    (assert (= (div 9 2) 4))
    (assert (= (mod 9 2) 1))
    (assert (= (mod -9223372036854775808 -1) 0))
    (assert (= (- 5) -5))
    (assert (<> 1 2))
    (assert (>= 2 2))
    (assert (not false))
    (var (large Set (set 9007199254740992)))
    (assert (not (in 9007199254740993 large)))
    (assert (not (= 9007199254740993 9007199254740992.0)))
    (assert (= 42 42.0))
    (assert (= (round 9007199254740993) 9007199254740993))
    (assert (= (trunc 9007199254740993) 9007199254740993))
    (assert (= #\null (chr 0)))
    (assert (< 9007199254740993 9007199254740994.0))
    (assert (> 9007199254740993 9007199254740992.0))
    (writeln "backend-coverage-ok")))
