(program RtlSmoke
  (uses SysUtils StrUtils Math DateUtils Character)

  (begin
    (assert (= (IntToStr 42) "42"))
    (assert (= (SysUtils.IntToStr 7) "7"))
    (assert (= (StrToInt "123") 123))
    (assert (= (ChangeFileExt "demo.txt" ".lfp") "demo.lfp"))
    (assert (StartsStr "lis" "lispal"))
    (assert (EndsStr "pal" "lispal"))
    (assert (ContainsStr "lispal" "spa"))
    (assert (= (ReverseString "abc") "cba"))
    (assert (> (Math.Power 2.0 8.0) 255.9))
    (assert (< (Math.Power 2.0 8.0) 256.1))
    (assert (Odd -3))
    (assert (IsInfinite Infinity))
    (assert (> (Variance (list 1.0 2.0 3.0)) 0.9999))
    (assert (< (Variance (list 1.0 2.0 3.0)) 1.0001))
    (assert (> (TotalVariance (list 1.0 2.0 3.0)) 1.9999))
    (assert (< (TotalVariance (list 1.0 2.0 3.0)) 2.0001))
    (assert (> (PopnVariance (list 1.0 2.0 3.0)) 0.6665))
    (assert (< (PopnVariance (list 1.0 2.0 3.0)) 0.6668))
    (assert (IsLeapYear 2024))
    (assert (not (SameYear (EncodeDateTime 2025 12 31 23 59 59 0) (EncodeDateTime 2026 1 1 0 0 0 0))))
    (assert (not (SameMonth (EncodeDateTime 2025 12 31 23 59 59 0) (EncodeDateTime 2026 1 1 0 0 0 0))))
    (assert (= (DaysInAMonth 2024 2) 29))
    (assert (Character.IsLetter "A"))
    (assert (Character.IsDigit "7"))
    (writeln "rtl-smoke-ok")))
