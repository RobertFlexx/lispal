(program RtlAllUnits
  (uses System SysUtils Math StrUtils DateUtils Dos Crt Strings Character Classes Types Variants ctypes UnixType Errors Dynlibs Objects WinCRT Keyboard Mouse Printer BaseUnix Unix Sockets UnixUtil Linux UnixCp WinDirs GetOpts Base64 URIParser HeapTrc HTTPProtocol)

  (var (HeapPointer Pointer (new 1))
       (UnixSize UnixType.TSize 7)
       (GeometrySize Types.TSize (Types.TSize 3 4)))

  (begin
    (assert (= (SysUtils.IntToStr 42) "42"))
    (assert (= (Math.RoundTo 12.3456 -2) 12.35))
    (assert (= (DateUtils.DaysInAMonth 2024 2) 29))
    (assert (StrUtils.ContainsText "Lispal" "ISP"))
    (assert (Character.IsLetter "L"))
    (assert (= (Objects.LongMul 6 7) 42))
    (assert (= UnixSize 7))
    (assert (= (field GeometrySize cx) 3))
    (assert (= (field GeometrySize cy) 4))
    (assert (= (UnixUtil.AddTrailingSeparator "tmp") (concat "tmp" System.DirectorySeparator)))
    (assert (= (Sockets.ShortNetToHost (Sockets.ShortHostToNet 4660)) 4660))
    (assert (= WinDirs.CSIDL_COMMON_DOCUMENTS 46))
    (assert (= GetOpts.No_Argument 0))
    (HeapTrc.CheckPointer HeapPointer)
    (assert (= (Base64.DecodeStringBase64 (Base64.EncodeStringBase64 "lispal") true) "lispal"))
    (assert (URIParser.IsAbsoluteURI "https://freepascal.org"))
    (assert (= (HTTPProtocol.HTTPEncode "a b+c") "a+b%2Bc"))
    (assert (= (HTTPProtocol.HTTPDecode "a+b%2Bc") "a b+c"))
    (assert (= (HTTPProtocol.HeaderName HTTPProtocol.hhContentType) "Content-Type"))
    (assert (= (HTTPProtocol.HeaderType "content-type") HTTPProtocol.hhContentType))
    (assert (= (HTTPProtocol.IncludeHTTPPathDelimiter "/tmp/test") "/tmp/test/"))
    (assert (= (HTTPProtocol.ExcludeHTTPPathDelimiter "/tmp/test/") "/tmp/test"))
    (writeln "rtl-all-units-ok")))
