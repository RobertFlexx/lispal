    (str S))

  (function SafeFormat ((S String)) String
    (str S))

  (function ExpandFileNameCase ((S String)) String
    (ExpandFileName S))

  (function ChangeFilePath ((FileName String) (Path String)) String
    (concat (IncludeTrailingPathDelimiter Path) (ExtractFileName FileName)))

  (function ExtractRelativePath ((BaseName String) (DestName String)) String
    (__rtl "extractrelativepath" BaseName DestName))

  (function ExeSearch ((Name String) (Path String)) String
    (FileSearch Name Path))

