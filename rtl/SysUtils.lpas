    (__rtl "diskfree" Drive))

  (function DiskSize ((Drive Integer)) Integer
    (__rtl "disksize" Drive))

  (function GetTickCount64 () Integer
    (__rtl "gettickcount64"))

  (function ExecuteProcess ((Path String) (CommandLine String)) Integer
    (__rtl "executeprocess" Path CommandLine))

  (function Date () TDateTime
    (__rtl "date"))

  (function Time () TDateTime
    (__rtl "time"))

  (function Now () TDateTime
    (__rtl "nowdatetime"))

  (function CurrentYear () Integer
    (__rtl "currentyear"))

  (function EncodeDate ((Year Integer) (Month Integer) (Day Integer)) TDateTime
    (__rtl "encodedate" Year Month Day))

  (function EncodeTime ((Hour Integer) (Minute Integer) (Second Integer) (MilliSecond Integer)) TDateTime
    (__rtl "encodetime" Hour Minute Second MilliSecond))

  (function DayOfWeek ((Value TDateTime)) Integer
    (__rtl "dayoftheweek" Value))

  (function IsLeapYear ((Year Integer)) Boolean
    (__rtl "isleapyear" Year))

  (function IncMonth ((Value TDateTime) (Months Integer)) TDateTime
    (__rtl "incmonth" Value Months))

  (function SameStr ((S1 String) (S2 String)) Boolean
    (= (CompareStr S1 S2) 0))

  (function SameText ((S1 String) (S2 String)) Boolean
    (= (CompareText S1 S2) 0))

  (function AnsiSameStr ((S1 String) (S2 String)) Boolean
    (SameStr S1 S2))

  (function AnsiSameText ((S1 String) (S2 String)) Boolean
    (SameText S1 S2))

  (function AnsiPos ((SubStr String) (S String)) Integer
    (pos SubStr S))

  (function AnsiLastChar ((S String)) String
    (if (= (length S) 0) "" (copy S (length S) 1)))

  (function AnsiStrLastChar ((S String)) String
    (AnsiLastChar S))

  (function AnsiStrComp ((S1 String) (S2 String)) Integer
    (CompareStr S1 S2))

  (function AnsiStrIComp ((S1 String) (S2 String)) Integer
    (CompareText S1 S2))

  (function AnsiStrLComp ((S1 String) (S2 String) (MaxLen Integer)) Integer
    (CompareStr (copy S1 1 MaxLen) (copy S2 1 MaxLen)))

  (function AnsiStrLIComp ((S1 String) (S2 String) (MaxLen Integer)) Integer
    (CompareText (copy S1 1 MaxLen) (copy S2 1 MaxLen)))

  (function AnsiStrLower ((S String)) String
    (LowerCase S))

  (function AnsiStrUpper ((S String)) String
    (UpperCase S))

  (function AnsiStrPos ((SubStr String) (S String)) Integer
    (pos SubStr S))

  (function AnsiStrScan ((S String) (C String)) Integer
    (pos C S))

  (function AnsiStrRScan ((S String) (C String)) Integer
    (__rtl "rpos" C S))

  (function StrLen ((S String)) Integer
    (length S))

  (function StrCharLength ((S String)) Integer
    (length S))

  (function ByteLength ((S String)) Integer
    (length S))

  (function ByteToCharIndex ((S String) (Index Integer)) Integer
    Index)

  (function ByteToCharLen ((S String) (MaxLen Integer)) Integer
    (min (length S) MaxLen))

  (function CharToByteLen ((S String) (MaxChars Integer)) Integer
    (min (length S) MaxChars))

  (function StrCopy ((S String)) String
    S)

  (function StrMove ((S String)) String
    S)

  (function StrPas ((S String)) String
    S)

  (function StrPCopy ((S String)) String
    S)

  (function StrPLCopy ((S String) (MaxLen Integer)) String
    (copy S 1 MaxLen))

  (function StrLCopy ((S String) (MaxLen Integer)) String
    (copy S 1 MaxLen))

  (function StrComp ((S1 String) (S2 String)) Integer
    (CompareStr S1 S2))

  (function StrIComp ((S1 String) (S2 String)) Integer
    (CompareText S1 S2))

  (function StrLComp ((S1 String) (S2 String) (MaxLen Integer)) Integer
    (CompareStr (copy S1 1 MaxLen) (copy S2 1 MaxLen)))

  (function StrLIComp ((S1 String) (S2 String) (MaxLen Integer)) Integer
    (CompareText (copy S1 1 MaxLen) (copy S2 1 MaxLen)))

  (function StrLower ((S String)) String
    (LowerCase S))

  (function StrUpper ((S String)) String
    (UpperCase S))

  (function StrPos ((SubStr String) (S String)) Integer
    (pos SubStr S))

  (function StrScan ((S String) (C String)) Integer
    (pos C S))

  (function StrRScan ((S String) (C String)) Integer
    (__rtl "rpos" C S))

  (function StrCat ((S1 String) (S2 String)) String
    (concat S1 S2))

  (function StrLCat ((S1 String) (S2 String) (MaxLen Integer)) String
    (copy (concat S1 S2) 1 MaxLen))

  (function StringReplace ((S String) (OldPattern String) (NewPattern String)) String
    (__rtl "replacestr" S OldPattern NewPattern))

  (function LastDelimiter ((Delimiters String) (S String)) Integer
    (__rtl "lastdelimiter" Delimiters S))

  (function LeftStr ((S String) (Count Integer)) String
    (copy S 1 Count))

  (function RightStr ((S String) (Count Integer)) String
    (__rtl "rightstr" S Count))

  (function IsPathDelimiter ((S String) (Index Integer)) Boolean
    (= (copy S Index 1) DirectorySeparator))

  (function IsDelimiter ((Delimiters String) (S String) (Index Integer)) Boolean
    (> (pos (copy S Index 1) Delimiters) 0))

  (function IncludeLeadingPathDelimiter ((Path String)) String
    (if (= (copy Path 1 1) DirectorySeparator) Path (concat DirectorySeparator Path)))

  (function ExcludeLeadingPathDelimiter ((Path String)) String
    (if (= (copy Path 1 1) DirectorySeparator) (copy Path 2 (- (length Path) 1)) Path))

  (function ExtractFileDrive ((FileName String)) String
    (if (= (copy FileName 2 1) ":") (copy FileName 1 2) ""))

  (function ExpandUNCFileName ((FileName String)) String
    (ExpandFileName FileName))

  (function ExtractShortPathName ((FileName String)) String
    FileName)

  (function SameFileName ((S1 String) (S2 String)) Boolean
    (SameText (ExpandFileName S1) (ExpandFileName S2)))

  (function FloatToDateTime ((Value Real)) TDateTime
    Value)

  (function FloatToCurr ((Value Real)) Real
    Value)

  (function ComposeDateTime ((DateValue TDateTime) (TimeValue TDateTime)) TDateTime
    (+ (trunc DateValue) (TimeOf TimeValue)))

  (function ReplaceDate ((DateTime TDateTime) (NewDate TDateTime)) TDateTime
    (+ (trunc NewDate) (TimeOf DateTime)))

  (function ReplaceTime ((DateTime TDateTime) (NewTime TDateTime)) TDateTime
    (+ (trunc DateTime) (TimeOf NewTime)))

  (function IncAMonth ((Year Integer) (Month Integer) (Day Integer) (NumberOfMonths Integer)) TDateTime
    (IncMonth (EncodeDate Year Month Day) NumberOfMonths))

  (function IfThen ((Condition Boolean) (TrueValue Variant) (FalseValue Variant)) Variant
    (if Condition TrueValue FalseValue))

  (function StrToBoolDef ((S String) (Default Boolean)) Boolean
    (cond ((SameText S "true") true) ((SameText S "false") false) (else Default)))

  (function DateTimeToStr ((Value TDateTime)) String
    (__rtl "datetimetostr" Value))

  (function DateToStr ((Value TDateTime)) String
    (__rtl "datetostr" Value))

  (function TimeToStr ((Value TDateTime)) String
    (__rtl "timetostr" Value))

