    (__rtl "formatdatetime" FormatString Value))

  (function FormatDateTime ((FormatString String) (Value TDateTime)) String
    (__rtl "formatdatetime" FormatString Value))

  (function FloatToStrF ((Value Real) (FormatString String)) String
